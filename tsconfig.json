{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["*.js"],
  "exclude": [
    "*-worker.js",
    "app.js",
    "eslint.config.js",
    "footer.js",
    "node_modules",
    "playwright.config.js",
    "public",
    "register-sw.js",
    "review.js",
    "sw.js",
    "train.js"
  ]
}
