{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["*.js"],
  "exclude": ["node_modules", "public", "sw.js", "eslint.config.js", "playwright.config.js"]
}
